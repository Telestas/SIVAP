# ── Python / FastAPI ──────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# ── Flutter / Dart ────────────────────────────────
.dart_tool/
.packages
.pub-cache/
.pub/
build/
*.iml
.flutter-plugins
.flutter-plugins-dependencies
**/ios/Pods/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/ephemeral/
**/android/.gradle/
**/android/local.properties
**/android/key.properties
*.jks
*.keystore

# ── Secretos y configuración local ────────────────
.env
.env.*
!.env.example
/deploy/.env

# ── TLS ───────────────────────────────────────────
# Certificados y claves del despliegue. Una clave privada versionada deja de
# ser privada, aunque el repositorio sea privado.
/deploy/tls/*
!/deploy/tls/generar-certificado.sh
!/deploy/tls/README.md
*.pem
*.key
secrets/

# ── Datos clínicos / exportaciones ────────────────
# Nunca versionar datos de pacientes ni datasets exportados.
#
# Los patrones van anclados con «/» a la raíz del repositorio. Sin anclar,
# `data/` excluía también `app/lib/data/` —el código de la capa de datos— y el
# repositorio quedaba sin compilar sin que nada avisara.
*.xlsx
*.csv
*.sqlite
*.db
*.db-journal
*.db-wal
*.db-shm
/data/
/exports/
/deploy/copias/

# ── Editores / SO ─────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.log
