# Copiar a .env y rellenar. El .env NO se versiona.

# ── Base de datos ────────────────────────────────────────────────────
POSTGRES_DB=sivap
POSTGRES_USER=sivap
# Generar con: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── Backend ──────────────────────────────────────────────────────────
# Firma de los tokens de sesión. Generar con: openssl rand -hex 32
# Cambiarla invalida todas las sesiones abiertas.
SIVAP_ENTORNO=produccion

# Cuántas posiciones de la secuencia de aleatorización recibe cada dispositivo.
# Es el equivalente digital de cuántos sobres numerados se da a cada centro: un
# tramo corto obliga a pedir otro a menudo, y hace falta conexión para pedirlo;
# uno largo desperdicia más posiciones si se pierde el teléfono, porque ese
# tramo queda quemado.
SIVAP_TAMANO_TRAMO=25

# Duración de la sesión de sincronización, en horas. Larga a propósito: un
# teléfono puede pasar semanas sin cobertura, y caducarle la sesión significaría
# que no puede enviar lo que ya capturó.
SIVAP_HORAS_SESION=720

# ── Panel web ────────────────────────────────────────────────────────
# Nombre por el que se llega al panel. En red interna, algo como
# sivap.hospital.local, resuelto por el DNS del hospital o por /etc/hosts.
SIVAP_DOMINIO=sivap.local
