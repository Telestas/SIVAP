rules_version = '2';

// La base Firebase consolida la cola local; no es un almacén abierto al cliente.
// Las solicitudes no conceden acceso clínico. Un principal aprueba en su centro.
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function perfilExiste() {
      return autenticado() &&
          exists(/databases/$(database)/documents/investigadores/$(request.auth.uid));
    }

    function perfil() {
      return get(/databases/$(database)/documents/investigadores/$(request.auth.uid)).data;
    }

    function tieneRol(rol) {
      return perfilExiste() && rol in perfil().roles;
    }

    function esPrincipal() {
      return tieneRol('investigadorPrincipal');
    }

    function mismaInstitucionNueva() {
      return perfilExiste() &&
          request.resource.data.institucion_codigo == perfil().institucion_codigo;
    }

    function mismaInstitucionExistente() {
      return perfilExiste() &&
          resource.data.institucion_codigo == perfil().institucion_codigo;
    }

    function creadoPorUsuarioActual() {
      return request.resource.data.autor_uid == request.auth.uid;
    }

    function esPreproduccion() {
      return exists(/databases/$(database)/documents/estudios/livere) &&
          get(/databases/$(database)/documents/estudios/livere).data.entorno == 'preproduccion' &&
          get(/databases/$(database)/documents/estudios/livere).data.captura_habilitada == true;
    }

    function centroAprobado() {
      return perfilExiste() &&
          get(/databases/$(database)/documents/instituciones/$(perfil().institucion_codigo))
              .data.cei_aprobado == true ||
          (perfilExiste() && esPreproduccion() &&
              get(/databases/$(database)/documents/instituciones/$(perfil().institucion_codigo))
                  .data.habilitado_pruebas == true);
    }

    function consentimientoAprobado() {
      return get(/databases/$(database)/documents/estudios/livere/configuracion/consentimiento)
          .data.aprobado == true ||
          (esPreproduccion() &&
              get(/databases/$(database)/documents/estudios/livere/configuracion/consentimiento)
                  .data.tipo == 'prueba' &&
              get(/databases/$(database)/documents/estudios/livere/configuracion/consentimiento)
                  .data.habilitado == true);
    }

    function asignacionReservada() {
      let tramo = get(/databases/$(database)/documents/tramos/$(request.resource.data.dispositivo_id)).data;
      let posicion = request.resource.data.posicion;
      return tramo.autor_uid == request.auth.uid &&
          tramo.institucion_codigo == request.resource.data.institucion_codigo &&
          tramo.etiqueta == request.resource.data.secuencia_etiqueta &&
          posicion is int && posicion >= tramo.desde && posicion < tramo.hasta &&
          tramo.codigo_binario[posicion - tramo.desde] ==
              (request.resource.data.protocolo == 'b' ? '1' : '0');
    }

    function veCohorteCompleta() {
      return tieneRol('evaluadorDesenlaces') || tieneRol('analista') ||
          esPrincipal();
    }

    function puedeLeerRegistroClinico() {
      return mismaInstitucionExistente() &&
          (veCohorteCompleta() || resource.data.autor_uid == request.auth.uid);
    }

    function puedeCrearTipoDeEvento() {
      return esPrincipal() ||
          (tieneRol('reclutador') &&
              request.resource.data.tipo == 'enrolamiento') ||
          (tieneRol('aplicador') &&
              request.resource.data.tipo in [
                'cribado',
                'prueba_ventilacion_espontanea',
                'extubacion'
              ]) ||
          (tieneRol('evaluadorDesenlaces') &&
              request.resource.data.tipo in [
                'desenlaces',
                'seguimiento_post_egreso'
              ]);
    }

    function rolAprobable(rol) {
      return rol in ['reclutador', 'aplicador', 'evaluadorDesenlaces', 'analista'];
    }

    match /solicitudes_acceso/{uid} {
      allow get: if autenticado() && (uid == request.auth.uid ||
          (esPrincipal() && mismaInstitucionExistente()));
      allow list: if esPrincipal() && mismaInstitucionExistente();
      allow create: if autenticado() && uid == request.auth.uid &&
          !perfilExiste() &&
          request.resource.data.keys().hasAll([
            'correo', 'nombre', 'institucion_codigo', 'estado', 'solicitado_en'
          ]) && request.resource.data.keys().hasOnly([
            'correo', 'nombre', 'institucion_codigo', 'estado', 'solicitado_en'
          ]) &&
          request.resource.data.correo == request.auth.token.email &&
          request.resource.data.nombre is string &&
          request.resource.data.nombre.size() >= 2 &&
          request.resource.data.nombre.size() <= 120 &&
          request.resource.data.institucion_codigo is string &&
          exists(/databases/$(database)/documents/instituciones/$(request.resource.data.institucion_codigo)) &&
          request.resource.data.estado ==
              (request.auth.token.email_verified == true
                  ? 'pendiente' : 'pendiente_verificacion') &&
          request.resource.data.solicitado_en == request.time;
      allow update: if autenticado() && uid == request.auth.uid &&
          request.auth.token.email_verified == true &&
          !perfilExiste() &&
          resource.data.estado == 'pendiente_verificacion' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']) &&
          request.resource.data.estado == 'pendiente';
      allow update: if esPrincipal() && uid != request.auth.uid &&
          mismaInstitucionExistente() && resource.data.estado == 'pendiente' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'estado', 'aprobado_por', 'aprobado_en', 'rol_aprobado'
          ]) &&
          request.resource.data.estado == 'aprobado' &&
          request.resource.data.aprobado_por == request.auth.uid &&
          request.resource.data.aprobado_en == request.time &&
          rolAprobable(request.resource.data.rol_aprobado) &&
          getAfter(/databases/$(database)/documents/investigadores/$(uid))
              .data.roles == [request.resource.data.rol_aprobado];
      allow delete: if false;
    }

    // El perfil se crea junto a la aprobación; el solicitante no lo escribe.
    match /investigadores/{uid} {
      allow get: if autenticado() && (uid == request.auth.uid ||
          (esPrincipal() && mismaInstitucionExistente()));
      allow list: if esPrincipal() && mismaInstitucionExistente();
      allow create: if esPrincipal() && uid != request.auth.uid &&
          request.resource.data.institucion_codigo == perfil().institucion_codigo &&
          request.resource.data.keys().hasAll([
            'nombre', 'correo', 'institucion_codigo', 'roles', 'aprobado_por', 'aprobado_en'
          ]) && request.resource.data.keys().hasOnly([
            'nombre', 'correo', 'institucion_codigo', 'roles', 'aprobado_por', 'aprobado_en'
          ]) &&
          request.resource.data.roles is list &&
          request.resource.data.roles.size() == 1 &&
          rolAprobable(request.resource.data.roles[0]) &&
          request.resource.data.aprobado_por == request.auth.uid &&
          request.resource.data.aprobado_en == request.time &&
          request.resource.data.correo ==
              getAfter(/databases/$(database)/documents/solicitudes_acceso/$(uid)).data.correo &&
          request.resource.data.nombre ==
              getAfter(/databases/$(database)/documents/solicitudes_acceso/$(uid)).data.nombre &&
          getAfter(/databases/$(database)/documents/solicitudes_acceso/$(uid)).data.estado == 'aprobado' &&
          getAfter(/databases/$(database)/documents/solicitudes_acceso/$(uid)).data.institucion_codigo ==
              request.resource.data.institucion_codigo &&
          getAfter(/databases/$(database)/documents/solicitudes_acceso/$(uid)).data.rol_aprobado ==
              request.resource.data.roles[0];
      allow update, delete: if false;
    }

    match /estudios/{estudioId} {
      allow get: if perfilExiste();
      allow list, create, update, delete: if false;

      match /configuracion/{documento} {
        allow get, list: if perfilExiste();
        allow create, update, delete: if false;
      }
    }

    // Solo una función del servidor puede activar el estudio y repartir tramos.
    match /instituciones/{codigo} {
      allow get: if perfilExiste() && codigo == perfil().institucion_codigo;
      allow list, write: if false;
    }
    match /aleatorizacion/{id} {
      allow read, write: if false;
    }
    match /tramos/{id} {
      allow get: if (tieneRol('reclutador') || esPrincipal()) &&
          get(/databases/$(database)/documents/dispositivos/$(id)).data.autor_uid == request.auth.uid;
      allow create, update: if (tieneRol('reclutador') || esPrincipal()) &&
          centroAprobado() && consentimientoAprobado() &&
          request.resource.data.autor_uid == request.auth.uid &&
          mismaInstitucionNueva() &&
          get(/databases/$(database)/documents/dispositivos/$(id)).data.autor_uid == request.auth.uid &&
          get(/databases/$(database)/documents/reservas_tramos/$(request.auth.uid)).data.dispositivo_id == null &&
          request.resource.data ==
              get(/databases/$(database)/documents/reservas_tramos/$(request.auth.uid)).data.tramo &&
          getAfter(/databases/$(database)/documents/reservas_tramos/$(request.auth.uid)).data.dispositivo_id == id;
      allow list, delete: if false;
    }
    // La CLI administrativa crea la reserva; el cliente solo la reclama una vez.
    match /reservas_tramos/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid &&
          (tieneRol('reclutador') || esPrincipal());
      allow update: if request.auth != null && request.auth.uid == uid &&
          (tieneRol('reclutador') || esPrincipal()) &&
          resource.data.dispositivo_id == null &&
          request.resource.data.dispositivo_id is string &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dispositivo_id']) &&
          getAfter(/databases/$(database)/documents/tramos/$(request.resource.data.dispositivo_id)).data ==
              resource.data.tramo;
      allow list, create, delete: if false;
    }

    match /dispositivos/{id} {
      allow create: if perfilExiste() && creadoPorUsuarioActual() &&
          mismaInstitucionNueva();
      allow get: if perfilExiste() && resource.data.autor_uid == request.auth.uid;
      allow update: if perfilExiste() &&
          resource.data.autor_uid == request.auth.uid &&
          request.resource.data.autor_uid == resource.data.autor_uid &&
          request.resource.data.institucion_codigo ==
              resource.data.institucion_codigo;
      allow delete, list: if false;
    }

    // La ficha identificable no comparte colección con los datos clínicos.
    match /identidades/{id} {
      allow create: if (tieneRol('reclutador') || esPrincipal()) &&
          mismaInstitucionNueva() && creadoPorUsuarioActual() &&
          centroAprobado() && consentimientoAprobado() &&
          getAfter(/databases/$(database)/documents/pacientes/$(id))
              .data.institucion_codigo == request.resource.data.institucion_codigo;
      allow get: if (tieneRol('reclutador') || esPrincipal()) &&
          mismaInstitucionExistente();
      allow list, update, delete: if false;
    }

    match /pacientes/{id} {
      allow create: if (tieneRol('reclutador') || esPrincipal()) &&
          mismaInstitucionNueva() && creadoPorUsuarioActual() &&
          centroAprobado() && consentimientoAprobado();
      allow get, list: if puedeLeerRegistroClinico();
      allow update, delete: if false;
    }

    // Separada del paciente para que el evaluador de desenlaces pueda leer la
    // cohorte sin recibir la rama asignada.
    match /asignaciones/{id} {
      allow create: if (tieneRol('reclutador') || esPrincipal()) &&
          mismaInstitucionNueva() && creadoPorUsuarioActual() &&
          centroAprobado() &&
          request.resource.data.protocolo in ['a', 'b'] &&
          asignacionReservada() &&
          getAfter(/databases/$(database)/documents/posiciones/$(string(request.resource.data.posicion)))
              .data.paciente_id == id;
      allow get, list: if mismaInstitucionExistente() &&
          !tieneRol('evaluadorDesenlaces') &&
          (tieneRol('reclutador') || tieneRol('aplicador') ||
              tieneRol('analista') || esPrincipal());
      allow update, delete: if false;
    }

    // Un documento por posición, creado en la misma transacción que la
    // asignación. La exclusividad del id impide duplicarla entre pacientes.
    match /posiciones/{posicion} {
      allow create: if (tieneRol('reclutador') || esPrincipal()) &&
          mismaInstitucionNueva() && creadoPorUsuarioActual() &&
          request.resource.data.posicion is int &&
          posicion == string(request.resource.data.posicion) &&
          getAfter(/databases/$(database)/documents/asignaciones/$(request.resource.data.paciente_id))
              .data.posicion == request.resource.data.posicion;
      allow get, list, update, delete: if false;
    }

    match /consentimientos/{id} {
      allow create: if (tieneRol('reclutador') || esPrincipal()) &&
          mismaInstitucionNueva() && creadoPorUsuarioActual() &&
          centroAprobado() &&
          consentimientoAprobado() &&
          request.resource.data.version_documento ==
              get(/databases/$(database)/documents/estudios/livere/configuracion/consentimiento)
                  .data.version &&
          request.resource.data.codigo_cei ==
              get(/databases/$(database)/documents/estudios/livere/configuracion/consentimiento)
                  .data.codigo_cei &&
          request.resource.data.documento_firmado.version ==
              request.resource.data.version_documento &&
          request.resource.data.documento_firmado.codigo_cei ==
              request.resource.data.codigo_cei &&
          request.resource.data.documento_firmado.parrafos is list &&
          request.resource.data.documento_firmado.parrafos.size() > 0 &&
          request.resource.data.documento_firmado.declaraciones is list &&
          request.resource.data.documento_firmado.declaraciones.size() > 0 &&
          request.resource.data.firma.trazos is list &&
          request.resource.data.firma.trazos.size() > 0 &&
          request.resource.data.firma.trazos[0].puntos is list &&
          request.resource.data.firma.trazos[0].puntos.size() > 0 &&
          getAfter(/databases/$(database)/documents/pacientes/$(request.resource.data.paciente_id))
              .data.institucion_codigo == request.resource.data.institucion_codigo;
      allow get, list: if (tieneRol('reclutador') || esPrincipal()) &&
          mismaInstitucionExistente();
      allow update, delete: if false;
    }

    match /eventos/{id} {
      allow create: if puedeCrearTipoDeEvento() && mismaInstitucionNueva() &&
          creadoPorUsuarioActual() && centroAprobado() &&
          getAfter(/databases/$(database)/documents/pacientes/$(request.resource.data.paciente_id))
              .data.institucion_codigo == request.resource.data.institucion_codigo &&
          getAfter(/databases/$(database)/documents/consentimientos/$(request.resource.data.consentimiento_id))
              .data.paciente_id == request.resource.data.paciente_id;
      allow get, list: if puedeLeerRegistroClinico();
      allow update, delete: if false;
    }

    // La auditoría es solo de inserción. Una corrección llega como un evento
    // nuevo y una entrada que conserva valor anterior, nuevo y motivo.
    match /auditoria/{id} {
      allow create: if perfilExiste() && mismaInstitucionNueva() &&
          creadoPorUsuarioActual() &&
          (request.resource.data.entidad != 'exportacion' ||
              ((tieneRol('analista') || esPrincipal()) &&
                  request.resource.data.campo == 'archivo')) &&
          (request.resource.data.entidad != 'consentimiento' ||
              request.resource.data.campo != 'archivo' ||
              tieneRol('reclutador') || esPrincipal());
      allow get, list: if mismaInstitucionExistente();
      allow update, delete: if false;
    }

    // Acuse idempotente: el mismo lote puede volver a enviarse sin duplicar
    // registros. Solo el dueño del dispositivo puede leer su acuse.
    match /lotes/{id} {
      allow create: if perfilExiste() && creadoPorUsuarioActual() &&
          mismaInstitucionNueva();
      allow get: if autenticado() &&
          (!exists(/databases/$(database)/documents/lotes/$(id)) ||
              resource.data.autor_uid == request.auth.uid);
      allow list, update, delete: if false;
    }

    // La secuencia completa y la administración permanecen privadas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
